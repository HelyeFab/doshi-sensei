# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.backup

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# Firebase service account key (DO NOT COMMIT)
firebase-service-account.json

# Generated PWA files
public/sw.js
public/workbox-*.js

# Kuromoji dictionary files (large binary files)
public/dict/

# Work in progress files
sensei-feedback/
src/utils/rate-limiter.ts

# Large icon source folder (backup)
# /flat-icons/
# flat-icons/

# Allow the public flat-icons that are actually used
# These are the minimal set of icons needed for the app

netlify/functions-backup/

scraping-next

# Tatoeba raw data (too large for git)
tatoeba/
scripts/process-tatoeba*.js

translation-scripts/

# Downloaded kana audio files (generated by script)
public/audio/kana/hiragana/*.mp3
public/audio/kana/katakana/*.mp3
# Keep the index file
!public/audio/kana/index.json

# Downloaded JLPT kanji audio files (generated by script)
public/audio/kanji/*/character/*.mp3
public/audio/kanji/*/onyomi/*.mp3
public/audio/kanji/*/kunyomi/*.mp3
# Keep the index file
!public/audio/kanji/index.json

