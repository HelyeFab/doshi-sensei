rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      // Allow read if the authenticated user ID matches the document ID
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow write if the authenticated user ID matches the document ID
      // and validate subscription data structure if present in the NEW data
      allow write: if request.auth != null && request.auth.uid == userId
        && (
          // Allow if no subscription data in the new document
          !('subscription' in request.resource.data) ||
          // Or if subscription data is properly structured
          (
            request.resource.data.subscription.keys().hasAll(['subscription', 'limits', 'currentUsage']) &&
            request.resource.data.subscription.subscription.keys().hasAll(['status', 'plan']) &&
            request.resource.data.subscription.subscription.plan in ['free', 'monthly', 'yearly'] &&
            request.resource.data.subscription.subscription.status in ['active', 'inactive', 'canceled', 'past_due', 'trialing'] &&
            request.resource.data.subscription.limits.keys().hasAll(['maxLists', 'maxDrillsPerDay', 'canSync', 'canSave']) &&
            request.resource.data.subscription.currentUsage.keys().hasAll(['listsCount', 'drillsToday', 'lastDrillDate']) &&
            request.resource.data.subscription.currentUsage.listsCount >= 0 &&
            request.resource.data.subscription.currentUsage.drillsToday >= 0 &&
            request.resource.data.subscription.currentUsage.drillsToday <= 1000 // Reasonable limit
          )
        );

      // Allow access to user's subcollections (wordLists, savedWords, etc.)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
