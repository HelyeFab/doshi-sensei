{
  "name": "Doshi Sensei - Japanese Learning",
  "short_name": "Doshi Sensei",
  "description": "Master Japanese verb conjugations and vocabulary with interactive practice, drills, and JLPT preparation",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#8a5cf6",
  "theme_color": "#8a5cf6",
  "orientation": "any",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "language", "learning"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "display_override": ["fullscreen", "minimal-ui", "standalone"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "Quick Practice",
      "short_name": "Practice",
      "description": "Jump into conjugation practice",
      "url": "/drill?source=pwa_shortcut&mode=quick",
