rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all users
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Allow only admin to write to resources folder
    match /resources/{allPaths=**} {
      allow write: if request.auth != null && 
        request.auth.token.admin == true;
    }
    
    // Allow only admin to write to test folder
    match /test/{allPaths=**} {
      allow write: if request.auth != null && 
        request.auth.token.admin == true;
    }
  }
}